diff --git a/sherpa-onnx/csrc/session.cc b/sherpa-onnx/csrc/session.cc
index 8206bb99..42c2f300 100755
--- a/sherpa-onnx/csrc/session.cc
+++ b/sherpa-onnx/csrc/session.cc
@@ -7,6 +7,7 @@
 #include <algorithm>
 #include <fstream>
 #include <sstream>
+#include <stdexcept>
 #include <string>
 #include <unordered_map>
 #include <utility>
@@ -424,6 +425,130 @@ Ort::SessionOptions GetSessionOptionsImpl(
 #endif
       break;
     }
+    case Provider::kQNN: {
+      if (std::find(available_providers.begin(), available_providers.end(),
+                    "QNNExecutionProvider") == available_providers.end()) {
+        std::ostringstream msg;
+        msg << "QNNExecutionProvider is unavailable. Available providers: "
+            << os.str();
+        SHERPA_ONNX_LOGE("%s", msg.str().c_str());
+        throw std::runtime_error(msg.str());
+      }
+
+      std::unordered_map<std::string, std::string> provider_options(config);
+      provider_options.erase("DEBUG");
+      std::vector<std::pair<std::string, std::string>> session_config_entries;
+      bool disable_cpu_ep_fallback = false;
+      if (provider_options.find("disable_cpu_ep_fallback") !=
+          provider_options.end()) {
+        disable_cpu_ep_fallback =
+            ToIntOrDefault(provider_options["disable_cpu_ep_fallback"], 0) == 1;
+        provider_options.erase("disable_cpu_ep_fallback");
+      }
+      for (auto it = provider_options.begin(); it != provider_options.end();) {
+        if (it->first.rfind("session.", 0) == 0 ||
+            it->first.rfind("ep.", 0) == 0) {
+          session_config_entries.emplace_back(it->first, it->second);
+          it = provider_options.erase(it);
+        } else {
+          ++it;
+        }
+      }
+      if (provider_options.find("backend_path") == provider_options.end() &&
+          provider_options.find("backend_type") == provider_options.end()) {
+        provider_options.emplace("backend_path", "libQnnHtp.so");
+      }
+      if (provider_options.find("log_severity_level") == provider_options.end()) {
+        provider_options.emplace("log_severity_level", "0");
+      }
+
+      std::vector<std::string> keys;
+      std::vector<std::string> values;
+      keys.reserve(provider_options.size());
+      values.reserve(provider_options.size());
+      for (const auto &kv : provider_options) {
+        keys.push_back(kv.first);
+        values.push_back(kv.second);
+      }
+
+      std::vector<const char *> key_ptrs;
+      std::vector<const char *> value_ptrs;
+      key_ptrs.reserve(keys.size());
+      value_ptrs.reserve(values.size());
+      for (size_t i = 0; i != keys.size(); ++i) {
+        key_ptrs.push_back(keys[i].c_str());
+        value_ptrs.push_back(values[i].c_str());
+      }
+
+      const auto &api = Ort::GetApi();
+      if (disable_cpu_ep_fallback) {
+        sess_opts.AddConfigEntry("session.disable_cpu_ep_fallback", "1");
+      }
+      for (const auto &entry : session_config_entries) {
+        sess_opts.AddConfigEntry(entry.first.c_str(), entry.second.c_str());
+      }
+      OrtStatus *status = api.SessionOptionsAppendExecutionProvider(
+          sess_opts, "QNN", key_ptrs.data(), value_ptrs.data(),
+          key_ptrs.size());
+      if (status) {
+        const char *msg = api.GetErrorMessage(status);
+        std::string error_msg = std::string("Failed to enable QNNExecutionProvider: ") +
+                                msg + ". Available providers: " + os.str();
+        SHERPA_ONNX_LOGE("%s", error_msg.c_str());
+        api.ReleaseStatus(status);
+        throw std::runtime_error(error_msg);
+      } else {
+        SHERPA_ONNX_LOGE("Use QNNExecutionProvider");
+      }
+      break;
+    }
   }
   return sess_opts;
 }
