+  int64_t ReadPositiveIntMetadata(const Ort::ModelMetadata &meta_data,
+                                  const char *key) {
+    auto value = LookupCustomModelMetaData(meta_data, key, allocator_);
+    if (value.empty()) {
+      return 0;
+    }
+
+    char *end = nullptr;
+    long parsed = std::strtol(value.c_str(), &end, 10);  // NOLINT
+    if (end == value.c_str() || *end != '\0' || parsed <= 0) {
+      SHERPA_ONNX_LOGE("Invalid positive integer metadata %s=%s", key,
+                       value.c_str());
+      SHERPA_ONNX_EXIT(-1);
+    }
+    return static_cast<int64_t>(parsed);
+  }
+
+  Ort::Value MaybeTrimStrictOutput(std::vector<Ort::Value> out) {
+    if (strict_token_bucket_ <= 0 || strict_max_frames_ <= 0 ||
+        strict_samples_per_frame_ <= 0 || out.size() < 2) {
+      return std::move(out[0]);
+    }
+
+    const float *audio = out[0].GetTensorData<float>();
+    auto audio_shape = out[0].GetTensorTypeAndShapeInfo().GetShape();
+    int64_t audio_samples = 1;
+    for (auto dim : audio_shape) {
+      audio_samples *= dim;
+    }
+    if (audio_samples <= 0) {
+      return std::move(out[0]);
+    }
+
+    const float *duration = out[1].GetTensorData<float>();
+    auto duration_shape = out[1].GetTensorTypeAndShapeInfo().GetShape();
+    int64_t duration_count = 1;
+    for (auto dim : duration_shape) {
+      duration_count *= dim;
+    }
+    if (duration_count <= 0) {
+      return std::move(out[0]);
+    }
+
+    double frames = 0.0;
+    for (int64_t i = 0; i != duration_count; ++i) {
+      if (duration[i] > 0) {
+        frames += duration[i];
+      }
+    }
+    const int64_t bounded_frames =
+        std::max<int64_t>(1, std::min<int64_t>(
+                                 strict_max_frames_,
+                                 static_cast<int64_t>(frames + 0.5)));
+    const int64_t trimmed_samples =
+        std::max<int64_t>(1, std::min<int64_t>(
+                                 audio_samples,
+                                 bounded_frames * strict_samples_per_frame_));
+    strict_audio_buffer_.assign(audio, audio + trimmed_samples);
+    strict_audio_shape_ = {1, trimmed_samples};
+    auto memory_info =
+        Ort::MemoryInfo::CreateCpu(OrtDeviceAllocator, OrtMemTypeDefault);
+    return Ort::Value::CreateTensor(memory_info, strict_audio_buffer_.data(),
+                                   strict_audio_buffer_.size(),
+                                   strict_audio_shape_.data(),
+                                   strict_audio_shape_.size());
+  }
+
